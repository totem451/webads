---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe."
  path="/404"
  breadcrumbs={[{ name: 'Inicio', path: '/' }]}
>
  <section class="mx-auto max-w-4xl px-4 py-24 text-center">
    <p class="font-mono text-sm text-fg-muted">404</p>
    <h1 class="mt-2 font-mono text-3xl font-bold text-fg">Página no encontrada</h1>
    <p class="mt-3 text-fg-muted">El artículo o la página que buscas no existe o se ha movido.</p>
    <a href="/blog" class="mt-6 inline-block rounded-md bg-accent-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-accent-700">
      Ir al blog
    </a>
  </section>
</BaseLayout>
