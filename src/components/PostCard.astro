---
import type { CollectionEntry } from 'astro:content';
import TagBadge from './TagBadge.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, hasFirstHandData } = post.data;
const slug = post.id.replace(/\.mdx?$/, '');

const formattedDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="border-b border-subtle py-6 first:pt-0 last:border-b-0">
  <a href={`/blog/${slug}`} class="group block">
    <div class="flex items-center gap-2 text-xs text-fg-muted">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {
        hasFirstHandData && (
          <span class="rounded-full bg-spark-500/10 px-2 py-0.5 text-spark-600 dark:text-spark-400">
            Dato real
          </span>
        )
      }
    </div>
    <h2 class="mt-2 font-mono text-xl font-bold text-fg group-hover:text-accent-600 dark:group-hover:text-accent-400">
      {title}
    </h2>
    <p class="mt-2 text-sm text-fg-muted">{description}</p>
  </a>
  <div class="mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => <TagBadge tag={tag} />)}
  </div>
</article>
