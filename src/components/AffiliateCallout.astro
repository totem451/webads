---
interface Props {
  /** Nombre del producto/servicio recomendado, ej. "RevenueCat". */
  title: string;
  href: string;
  /** Texto corto del botón/CTA. */
  ctaLabel?: string;
}

const { title, href, ctaLabel = 'Ver ' + title } = Astro.props;
---

<aside class="not-prose my-6 rounded-lg border border-accent-500/30 bg-accent-500/5 p-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="font-mono text-sm font-semibold text-fg">{title}</p>
      <div class="mt-1 text-sm text-fg-muted">
        <slot />
      </div>
    </div>
    <a
      href={href}
      rel="sponsored noopener noreferrer"
      target="_blank"
      class="shrink-0 rounded-md bg-accent-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-700"
    >
      {ctaLabel}
    </a>
  </div>
  <p class="mt-3 text-xs text-fg-muted">
    Enlace de afiliado: si te suscribes a través de él, puedo recibir una comisión sin coste extra para
    ti. Ver <a href="/disclosure" class="underline hover:text-fg">política de divulgación</a>.
  </p>
</aside>
