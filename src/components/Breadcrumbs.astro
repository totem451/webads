---
import type { BreadcrumbItem } from '../lib/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

{
  items.length > 1 && (
    <nav aria-label="Breadcrumb" class="mx-auto max-w-4xl px-4 pt-4">
      <ol class="flex flex-wrap items-center gap-1 text-xs text-fg-muted">
        {items.map((item, index) => (
          <li class="flex items-center gap-1">
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === items.length - 1 ? (
              <span class="text-fg" aria-current="page">
                {item.name}
              </span>
            ) : (
              <a href={item.path} class="hover:text-accent-600 dark:hover:text-accent-400">
                {item.name}
              </a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
